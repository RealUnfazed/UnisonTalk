# Copy this file to .env and fill in real values before running the app.

# MongoDB connection string (local install or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/unisontalk

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

# Encrypts Cloud Chat message text and attachment filenames at rest in
# MongoDB (Secret Chats don't use this — they're encrypted client-side and
# the server never has that key). Must be a 64-character hex string (32
# bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this OUT of your database backups and version control — it's what
# makes a database dump alone insufficient to read Cloud Chat messages.
# Losing it makes existing Cloud Chat messages permanently unreadable, and
# changing it does the same, so store it somewhere durable (a secrets
# manager, not just this file) once you have real data.
CLOUD_ENCRYPTION_KEY=replace_this_with_a_64_character_hex_string

# Port the Express + Socket.IO server listens on
PORT=3000

# Comma-separated list of origins allowed to call this API with credentials
# (cookies). Leave unset during local development (defaults to reflecting
# whatever origin made the request) — but set this to your real client
# origin(s) before deploying publicly, e.g.:
# ALLOWED_ORIGIN=https://chat.example.com,https://app.example.com
ALLOWED_ORIGIN=

# Optional: "Continue with Phasetime" single sign-on
# (https://github.com/RealUnfazed/Phasetime-SSO). Leave all four unset to
# disable this login method entirely — nothing else in the app requires it.
#
# 1. Register this app as a client in your Phasetime instance's admin
#    panel (Client apps -> register a new one) to get a client_id/secret.
# 2. PHASETIME_REDIRECT_URI must match what you register there EXACTLY,
#    byte for byte — Phasetime rejects anything else, by design.
# 3. PHASETIME_SSO_BASE_URL points at whichever instance you trust —
#    the public one at https://account.unfazed.ir, or your own self-hosted
#    deployment of the same open-source server.
PHASETIME_SSO_BASE_URL=https://account.unfazed.ir
PHASETIME_CLIENT_ID=
PHASETIME_CLIENT_SECRET=
PHASETIME_REDIRECT_URI=http://localhost:3000/api/auth/sso/phasetime/callback


# --- Production hardening (all optional in development) ---------------------
# Set to "production" when deploying: enables Secure cookies, HSTS, and
# refuses to start with a weak SESSION_SECRET (needs >= 32 random characters).
NODE_ENV=development

# How many reverse proxies sit in front of this server (nginx, Render, Fly,
# Cloudflare...). Needed so Secure cookies and per-IP rate limiting see the
# real client. Leave UNSET if clients connect directly — setting it then lets
# anyone spoof their IP via X-Forwarded-For.
TRUST_PROXY=

# Set to "false" only to test production mode over plain HTTP.
# COOKIE_SECURE=

# Content-Security-Policy: report-only (default) | enforce | off.
# Load the app with report-only, check the browser console for violations,
# then switch to enforce.
CSP_MODE=report-only

# --- Operations (all optional) ---------------------------------------------
# Logging. LOG_LEVEL: debug | info | warn | error | silent.
# LOG_FORMAT: json (default when NODE_ENV=production) | pretty.
LOG_LEVEL=info
# LOG_FORMAT=

# Run several instances: point them all at the same Redis. Unset = single
# process (in-memory rate limits and Socket.IO). See "Deployment" in the README.
# REDIS_URL=redis://localhost:6379

# Where uploaded files live (the Docker image uses /data/uploads).
# UPLOAD_DIR=

# Seconds-ish knobs, in milliseconds. A user only goes "offline" this long
# after their last connection drops (rides out page refreshes).
# PRESENCE_GRACE_MS=3000
# Time to let a load balancer drain this instance on SIGTERM, and the hard
# deadline for the whole graceful shutdown.
# SHUTDOWN_DRAIN_MS=0
# SHUTDOWN_TIMEOUT_MS=15000

# "websocket" skips HTTP long-polling, so no sticky sessions are needed behind
# a load balancer — but the client must be configured the same way.
# SOCKET_TRANSPORTS=
