# Copy this file to .env and fill in real values before running the app.

# MongoDB connection string (local install or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/unisontalk

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

# Port the Express + Socket.IO server listens on
PORT=3000

# Comma-separated list of origins allowed to call this API with credentials
# (cookies). Leave unset during local development (defaults to reflecting
# whatever origin made the request) — but set this to your real client
# origin(s) before deploying publicly, e.g.:
# ALLOWED_ORIGIN=https://chat.example.com,https://app.example.com
ALLOWED_ORIGIN=
