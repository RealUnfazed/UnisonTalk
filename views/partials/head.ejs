<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= typeof title !== 'undefined' ? title + ' · UnisonTalk' : 'UnisonTalk' %></title>
<link rel="icon" href="data:," />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
/>

<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          ink: '#1B2036',
          'ink-light': '#262C46',
          mist: '#EEF1F0',
          signal: '#D9A62E',
          'signal-dark': '#B5871F',
          harmony: '#3E8E7E',
          ember: '#C1523B',
          slate: {
            DEFAULT: '#5B6472',
          },
        },
        fontFamily: {
          display: ['"Space Grotesk"', 'sans-serif'],
          sans: ['Manrope', 'sans-serif'],
        },
      },
    },
  };
</script>

<style>
  body {
    font-family: 'Manrope', sans-serif;
  }
  .font-display {
    font-family: 'Space Grotesk', sans-serif;
  }
  /* Message bubble tails: own vs. others get an asymmetric corner instead of
     the identical-rounded-card look, so the shape itself signals direction. */
  .bubble-own {
    border-radius: 1rem 1rem 0.25rem 1rem;
  }
  .bubble-other {
    border-radius: 1rem 1rem 1rem 0.25rem;
  }
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-thumb {
    background-color: rgba(27, 32, 54, 0.2);
    border-radius: 999px;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 0.3; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-2px); }
  }
  .typing-dot {
    animation: pulse-dot 1s infinite ease-in-out;
  }
</style>
